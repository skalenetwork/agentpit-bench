  - family-names: "Kladko"
    given-names: "Stan"
    affiliation: "SKALE Labs"
repository-code: "https://github.com/skalenetwork/agentpit-bench"
url: "https://agentpitbench.org/"
license: AGPL-3.0-only
keywords:
  - llm-benchmark
  - forecasting
  - prediction-markets
  - ai-agents
version: "methodology-1.0"
date-released: "2026-10-09"
